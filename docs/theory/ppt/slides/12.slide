<Slide style={{
  width: '1280px', height: '720px',
  background: '#FAF7F2', padding: '40px 60px 20px',
  flexDirection: 'column',
}}>
  {/* A 标题区 */}
  <Box style={{ marginBottom: 12 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 4 }}>
      <Box style={{ background: '#C9A227', borderRadius: 6, padding: '4px 10px' }}>
        <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#fff' }}>战术库</Text>
      </Box>
      <Text style={{ fontSize: 14, color: '#6B6B6B' }}>第三章 · 攻防战术</Text>
    </Box>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#2B2B2B' }}>
      腾挪 · <span style={{ color: '#C9A227' }}>放飞鸽</span> · 欺骗
    </Text>
  </Box>
  {/* B 内容区 - 左标题+右内容 30:70 */}
  <Box style={{ flexDirection: 'row', gap: 20, flex: 1, height: 500 }}>
    {/* 左侧色块标题栏 30% */}
    <Box style={{ flex: 30, background: 'linear-gradient(135deg, #8B1A1A 0%, #6B1010 100%)', borderRadius: 16, padding: 24, flexDirection: 'column', justifyContent: 'center', gap: 16 }}>
      <Text style={{ fontSize: 14, color: '#E8C98A', letterSpacing: 4 }}>TACTICS</Text>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FDF6EC', lineHeight: 1.3 }}>三种<br />进阶<br />战术</Text>
      <Text style={{ fontSize: 15, color: '#F3D9B5', lineHeight: 1.7 }}>
        都是在机会数基础上的"高阶操作"：<br /><br />
        <span style={{ fontWeight: 'bold', color: '#E8C98A' }}>先算机会数定方向</span>，再考虑骗招和误导。
      </Text>
    </Box>
    {/* 右侧三张战术卡片 70% */}
    <Box style={{ flex: 70, flexDirection: 'column', gap: 12 }}>
      {/* 腾挪 */}
      <Box style={{ flex: 1, background: '#FFFEF8', borderRadius: 12, padding: 16, border: '1px solid #eee4d2', flexDirection: 'row', gap: 16, alignItems: 'center' }}>
        <Box style={{ width: 48, height: 48, borderRadius: 12, background: '#1A7F5C', justifyContent: 'center', alignItems: 'center', flexShrink: 0 }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#fff' }}>腾</Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A7F5C' }}>腾挪战术</Text>
          <Text style={{ fontSize: 14, color: '#4a4038', lineHeight: 1.6 }}>
            调整牌型结构腾出最佳进张位，<span style={{ fontWeight: 'bold' }}>不破坏 27/28/37 强组合</span>。例：手有 2万+7万，进 3万 → 组成 234万顺子，7万留着继续辐射——而不是拆 2+7。
          </Text>
        </Box>
        <svg width={200} height={50} viewBox="0 0 200 50">
          <rect x="5" y="5" width="40" height="40" rx="5" fill="#F0FBF5" stroke="#1A7F5C" strokeWidth="1.5" />
          <text x="25" y="26" textAnchor="middle" fontSize="16" fontWeight="bold" fill="#1A7F5C">2</text>
          <text x="25" y="40" textAnchor="middle" fontSize="9" fill="#1A7F5C">万</text>
          <text x="52" y="28" fontSize="12" fill="#1A7F5C">+</text>
          <rect x="60" y="5" width="40" height="40" rx="5" fill="#F0FBF5" stroke="#1A7F5C" strokeWidth="1.5" />
          <text x="80" y="26" textAnchor="middle" fontSize="16" fontWeight="bold" fill="#1A7F5C">3</text>
          <text x="80" y="40" textAnchor="middle" fontSize="9" fill="#1A7F5C">万</text>
          <text x="107" y="28" fontSize="12" fill="#1A7F5C">→</text>
          <rect x="120" y="5" width="40" height="40" rx="5" fill="#FFF5F0" stroke="#C9A227" strokeWidth="2" />
          <text x="140" y="26" textAnchor="middle" fontSize="16" fontWeight="bold" fill="#1A7F5C">7</text>
          <text x="140" y="40" textAnchor="middle" fontSize="9" fill="#1A7F5C">万</text>
          <text x="170" y="28" fontSize="11" fill="#1A7F5C" fontWeight="bold">留着!</text>
        </svg>
      </Box>
      {/* 放飞鸽 */}
      <Box style={{ flex: 1, background: '#FFFEF8', borderRadius: 12, padding: 16, border: '1px solid #eee4d2', flexDirection: 'row', gap: 16, alignItems: 'center' }}>
        <Box style={{ width: 48, height: 48, borderRadius: 12, background: '#C9A227', justifyContent: 'center', alignItems: 'center', flexShrink: 0 }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#fff' }}>放</Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#C9A227' }}>放飞鸽战术</Text>
          <Text style={{ fontSize: 14, color: '#4a4038', lineHeight: 1.6 }}>
            碰3筒后<span style={{ fontWeight: 'bold' }}>故意放飛4筒</span> → 对手以为你不要筒子了，后面更敢打筒子 → 实际你在等自摸。把"看似有用"的牌扔出去，引诱对手松懈。
          </Text>
        </Box>
        <svg width={200} height={50} viewBox="0 0 200 50">
          <rect x="5" y="5" width="40" height="40" rx="5" fill="#FFF8E8" stroke="#C9A227" strokeWidth="1.5" />
          <text x="25" y="26" textAnchor="middle" fontSize="16" fontWeight="bold" fill="#C0392B">3</text>
          <text x="25" y="40" textAnchor="middle" fontSize="9" fill="#C0392B">筒</text>
          <text x="52" y="28" fontSize="12" fill="#C9A227">碰→</text>
          <rect x="80" y="5" width="40" height="40" rx="5" fill="#FFF5F0" stroke="#8B1A1A" strokeWidth="2" strokeDasharray="3" />
          <text x="100" y="26" textAnchor="middle" fontSize="16" fontWeight="bold" fill="#C0392B">4</text>
          <text x="100" y="40" textAnchor="middle" fontSize="9" fill="#C0392B">筒</text>
          <text x="130" y="28" fontSize="12" fill="#8B1A1A" fontWeight="bold">放飞!</text>
          <text x="165" y="28" fontSize="10" fill="#999">引诱</text>
        </svg>
      </Box>
      {/* 欺骗 */}
      <Box style={{ flex: 1, background: '#FFFEF8', borderRadius: 12, padding: 16, border: '1px solid #eee4d2', flexDirection: 'row', gap: 16, alignItems: 'center' }}>
        <Box style={{ width: 48, height: 48, borderRadius: 12, background: '#8B1A1A', justifyContent: 'center', alignItems: 'center', flexShrink: 0 }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#fff' }}>骗</Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#8B1A1A' }}>欺骗战术（单吊骗招）</Text>
          <Text style={{ fontSize: 14, color: '#4a4038', lineHeight: 1.6 }}>
            单吊 4、7万时，<span style={{ fontWeight: 'bold' }}>故意打中间张 4万</span>，诱出 7万。258、369 同理——单吊打中间效果比打边张好，因为中间张看起来更"没用"。
          </Text>
        </Box>
        <svg width={200} height={50} viewBox="0 0 200 50">
          <text x="10" y="28" fontSize="11" fill="#999">单吊4/7万</text>
          <rect x="65" y="5" width="40" height="40" rx="5" fill="#FFF5F0" stroke="#8B1A1A" strokeWidth="2" strokeDasharray="3" />
          <text x="85" y="26" textAnchor="middle" fontSize="16" fontWeight="bold" fill="#1A7F5C">4</text>
          <text x="85" y="40" textAnchor="middle" fontSize="9" fill="#1A7F5C">万</text>
          <text x="112" y="28" fontSize="11" fill="#8B1A1A" fontWeight="bold">打掉→</text>
          <rect x="145" y="5" width="40" height="40" rx="5" fill='#FFF5F0' stroke='#1A7F5C' strokeWidth="2.5" />
          <text x="165" y="26" textAnchor="middle" fontSize="16" fontWeight="bold" fill="#1A7F5C">7</text>
          <text x="165" y="40" textAnchor="middle" fontSize="9" fill="#1A7F5C">万</text>
          <text x="190" y="28" fontSize="10" fill="#1A7F5C" fontWeight="bold">到手!</text>
        </svg>
      </Box>
    </Box>
  </Box>
  {/* C 页脚 */}
  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'flex-end', alignItems: 'center', marginTop: 8 }}>
    <Text style={{ fontSize: 14, color: '#a0a0a0' }}>12 / 16</Text>
  </Box>
</Slide>
