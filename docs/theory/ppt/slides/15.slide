<Slide style={{
  width: '1280px', height: '720px',
  background: '#FAF7F2', padding: '40px 60px 20px',
  flexDirection: 'column',
}}>
  {/* A 标题区 */}
  <Box style={{ marginBottom: 16 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 4 }}>
      <Box style={{ background: '#1A7F5C', borderRadius: 6, padding: '4px 10px' }}>
        <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#fff' }}>落地状态</Text>
      </Box>
      <Text style={{ fontSize: 14, color: '#6B6B6B' }}>第四章 · 实战速查</Text>
    </Box>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#2B2B2B' }}>
      理论 → 代码<span style={{ color: '#1A7F5C' }}>，落地了多少？</span>
    </Text>
  </Box>
  {/* B 内容区 - 巨型数字 + 洞察（非对称 60:40） */}
  <Box style={{ flexDirection: 'row', gap: 24, flex: 1, height: 500 }}>
    {/* 左：SVG 状态板 */}
    <Box style={{ flex: 6, background: '#FFFEF8', borderRadius: 16, padding: 24, border: '1px solid #eee4d2', flexDirection: 'column', gap: 10 }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#3a2a1a', marginBottom: 4 }}>7 个理论点 → 5 个已进代码</Text>
      {/* 已实现 5 项 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 22, height: 22, borderRadius: 11, background: '#1A7F5C', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#fff' }}>✓</Text>
        </Box>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#2B2B2B', width: 140 }}>机会数计算</Text>
        <Text style={{ fontSize: 13, color: '#6B6B6B' }}>mahjongTheory.ts · 已接入 AI 出牌</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 22, height: 22, borderRadius: 11, background: '#1A7F5C', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#fff' }}>✓</Text>
        </Box>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#2B2B2B', width: 140 }}>强组合检测</Text>
        <Text style={{ fontSize: 13, color: '#6B6B6B' }}>复盘「拆强组合」诊断</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 22, height: 22, borderRadius: 11, background: '#1A7F5C', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#fff' }}>✓</Text>
        </Box>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#2B2B2B', width: 140 }}>安全分</Text>
        <Text style={{ fontSize: 13, color: '#6B6B6B' }}>复盘「尾盘危险牌」诊断</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 22, height: 22, borderRadius: 11, background: '#1A7F5C', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#fff' }}>✓</Text>
        </Box>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#2B2B2B', width: 140 }}>番种速查</Text>
        <Text style={{ fontSize: 13, color: '#6B6B6B' }}>CHENGDU_FAN_TABLE</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 8 }}>
        <Box style={{ width: 22, height: 22, borderRadius: 11, background: '#1A7F5C', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#fff' }}>✓</Text>
        </Box>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#2B2B2B', width: 140 }}>复盘引擎</Text>
        <Text style={{ fontSize: 13, color: '#6B6B6B' }}>analyzer.ts · 2 问题 + 1 亮点</Text>
      </Box>
      {/* 待做 2 项 */}
      <Box style={{ background: '#faf5ec', borderRadius: 10, padding: '10px 14px', gap: 8, flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 22, height: 22, borderRadius: 11, background: '#C9A227', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#fff' }}>…</Text>
          </Box>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#8B6F1F', width: 140 }}>训练题生成</Text>
          <Text style={{ fontSize: 13, color: '#8a7a5a' }}>M3 · 出「打哪张机会数最大」题</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 22, height: 22, borderRadius: 11, background: '#C9A227', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#fff' }}>…</Text>
          </Box>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#8B6F1F', width: 140 }}>副露牌效评估</Text>
          <Text style={{ fontSize: 13, color: '#8a7a5a' }}>M4 · 碰/杠后的机会数计算</Text>
        </Box>
      </Box>
    </Box>
    {/* 右：巨型数字 */}
    <Box style={{ flex: 4, background: 'linear-gradient(150deg, #8B1A1A 0%, #5C0E0E 100%)', borderRadius: 16, padding: 24, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 10 }}>
      <Text style={{ fontSize: 110, fontWeight: 'bold', color: '#FDF6EC', lineHeight: 1 }}>5</Text>
      <Text style={{ fontSize: 22, color: '#F3D9B5', fontWeight: 'bold' }}>/ 7 理论点已落地</Text>
      {/* 进度条：5 绿 2 金 */}
      <svg width={300} height={26} viewBox="0 0 300 26" style={{ marginTop: 8 }}>
        <rect x="0" y="6" width="40" height="14" rx="7" fill="#1A7F5C" />
        <rect x="44" y="6" width="40" height="14" rx="7" fill="#1A7F5C" />
        <rect x="88" y="6" width="40" height="14" rx="7" fill="#1A7F5C" />
        <rect x="132" y="6" width="40" height="14" rx="7" fill="#1A7F5C" />
        <rect x="176" y="6" width="40" height="14" rx="7" fill="#1A7F5C" />
        <rect x="220" y="6" width="40" height="14" rx="7" fill="#C9A227" opacity="0.55" />
        <rect x="264" y="6" width="36" height="14" rx="7" fill="#C9A227" opacity="0.55" />
      </svg>
      <Box style={{ flexDirection: 'row', gap: 16, marginTop: 6 }}>
        <Text style={{ fontSize: 13, color: '#E8C98A' }}>92 测试全绿</Text>
        <Text style={{ fontSize: 13, color: '#E8C98A' }}>·</Text>
        <Text style={{ fontSize: 13, color: '#E8C98A' }}>tag v0.1-stage</Text>
      </Box>
      <Text style={{ fontSize: 14, color: '#F3D9B5', opacity: 0.85, marginTop: 10, textAlign: 'center', lineHeight: 1.6 }}>
        看书学的是理论，<br />代码里跑的是决策。
      </Text>
    </Box>
  </Box>
  {/* C 页脚 */}
  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'flex-end', alignItems: 'center', marginTop: 12 }}>
    <Text style={{ fontSize: 14, color: '#a0a0a0' }}>15 / 16</Text>
  </Box>
</Slide>
