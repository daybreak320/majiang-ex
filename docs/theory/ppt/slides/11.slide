<Slide style={{
  width: '1280px', height: '720px',
  background: '#FAF7F2', padding: '40px 60px 20px',
  flexDirection: 'column',
}}>
  {/* A 标题区 */}
  <Box style={{ marginBottom: 12 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 4 }}>
      <Box style={{ background: '#8B1A1A', borderRadius: 6, padding: '4px 10px' }}>
        <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#fff' }}>防守核心</Text>
      </Box>
      <Text style={{ fontSize: 14, color: '#6B6B6B' }}>第三章 · 攻防战术</Text>
    </Box>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#2B2B2B' }}>
      什么是<span style={{ color: '#8B1A1A' }}>踩线</span>？
    </Text>
  </Box>
  {/* B 内容区 - 非对称双栏 55:45 */}
  <Box style={{ flexDirection: 'row', gap: 24, flex: 1, height: 500 }}>
    {/* 左侧：SVG 线路图 55% */}
    <Box style={{ flex: 55, background: '#FFFEF8', borderRadius: 16, padding: 24, border: '1px solid #eee4d2', flexDirection: 'column', justifyContent: 'center', gap: 16 }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#3a2a1a', textAlign: 'center' }}>
        1-9 按模 3 分成三条"线"
      </Text>
      <svg width={560} height={340} viewBox="0 0 560 340">
        {/* 第一条线：1-4-7（红色线） */}
        <line x1="30" y1="50" x2="530" y2="50" stroke="#8B1A1A" strokeWidth="2" opacity="0.4" />
        <text x="15" y="54" textAnchor="middle" fontSize="12" fill="#8B1A1A" fontWeight="bold">线1</text>
        <rect x="50" y="20" width="50" height="60" rx="6" fill="#FFF5F0" stroke="#8B1A1A" strokeWidth="2" />
        <text x="75" y="48" textAnchor="middle" fontSize="22" fontWeight="bold" fill="#1A7F5C">1</text>
        <text x="75" y="66" textAnchor="middle" fontSize="12" fill="#1A7F5C">万</text>
        <rect x="260" y="20" width="50" height="60" rx="6" fill="#FFF5F0" stroke="#8B1A1A" strokeWidth="2" />
        <text x="285" y="48" textAnchor="middle" fontSize="22" fontWeight="bold" fill="#1A7F5C">4</text>
        <text x="285" y="66" textAnchor="middle" fontSize="12" fill="#1A7F5C">万</text>
        <rect x="470" y="20" width="50" height="60" rx="6" fill="#FFF5F0" stroke="#8B1A1A" strokeWidth="2" />
        <text x="495" y="48" textAnchor="middle" fontSize="22" fontWeight="bold" fill="#1A7F5C">7</text>
        <text x="495" y="66" textAnchor="middle" fontSize="12" fill="#1A7F5C">万</text>
        <text x="200" y="54" textAnchor="middle" fontSize="12" fill="#8B1A1A" opacity="0.6">← 同线 →</text>
        <text x="400" y="54" textAnchor="middle" fontSize="12" fill="#8B1A1A" opacity="0.6">← 同线 →</text>

        {/* 第二条线：2-5-8（金色线） */}
        <line x1="30" y1="160" x2="530" y2="160" stroke="#C9A227" strokeWidth="2" opacity="0.4" />
        <text x="15" y="164" textAnchor="middle" fontSize="12" fill="#C9A227" fontWeight="bold">线2</text>
        <rect x="130" y="130" width="50" height="60" rx="6" fill="#FFF8E8" stroke="#C9A227" strokeWidth="2" />
        <text x="155" y="158" textAnchor="middle" fontSize="22" fontWeight="bold" fill="#1A7F5C">2</text>
        <text x="155" y="176" textAnchor="middle" fontSize="12" fill="#1A7F5C">万</text>
        <rect x="340" y="130" width="50" height="60" rx="6" fill="#FFF8E8" stroke="#C9A227" strokeWidth="2" />
        <text x="365" y="158" textAnchor="middle" fontSize="22" fontWeight="bold" fill="#1A7F5C">5</text>
        <text x="365" y="176" textAnchor="middle" fontSize="12" fill="#1A7F5C">万</text>
        <rect x="420" y="130" width="50" height="60" rx="6" fill="#FFF8E8" stroke="#C9A227" strokeWidth="2" />
        <text x="445" y="158" textAnchor="middle" fontSize="22" fontWeight="bold" fill="#1A7F5C">8</text>
        <text x="445" y="176" textAnchor="middle" fontSize="12" fill="#1A7F5C">万</text>
        <text x="250" y="164" textAnchor="middle" fontSize="12" fill="#C9A227" opacity="0.6">← 同线 →</text>

        {/* 第三条线：3-6-9（绿色线） */}
        <line x1="30" y1="270" x2="530" y2="270" stroke="#1A7F5C" strokeWidth="2" opacity="0.4" />
        <text x="15" y="274" textAnchor="middle" fontSize="12" fill="#1A7F5C" fontWeight="bold">线3</text>
        <rect x="210" y="240" width="50" height="60" rx="6" fill="#F0FBF5" stroke="#1A7F5C" strokeWidth="2" />
        <text x="235" y="268" textAnchor="middle" fontSize="22" fontWeight="bold" fill="#1A7F5C">3</text>
        <text x="235" y="286" textAnchor="middle" fontSize="12" fill="#1A7F5C">万</text>
        <rect x="370" y="240" width="50" height="60" rx="6" fill="#F0FBF5" stroke="#1A7F5C" strokeWidth="2" />
        <text x="395" y="268" textAnchor="middle" fontSize="22" fontWeight="bold" fill="#1A7F5C">6</text>
        <text x="395" y="286" textAnchor="middle" fontSize="12" fill="#1A7F5C">万</text>
        <rect x="500" y="240" width="50" height="60" rx="6" fill="#F0FBF5" stroke="#1A7F5C" strokeWidth="2" />
        <text x="525" y="268" textAnchor="middle" fontSize="22" fontWeight="bold" fill="#1A7F5C">9</text>
        <text x="525" y="286" textAnchor="middle" fontSize="12" fill="#1A7F5C">万</text>
        <text x="320" y="274" textAnchor="middle" fontSize="12" fill="#1A7F5C" opacity="0.6">← 同线 →</text>

        {/* 安全标注 */}
        <text x="280" y="320" textAnchor="middle" fontSize="14" fill="#8B1A1A" fontWeight="bold">
          别人打了 1 → 同线的 4、7 更安全（组顺子时互相"竞争"）
        </text>
      </svg>
    </Box>
    {/* 右侧：文字解释 45% */}
    <Box style={{ flex: 45, flexDirection: 'column', gap: 14, justifyContent: 'center' }}>
      <Box style={{ background: '#FFFEF8', borderRadius: 12, padding: 20, border: '1px solid #eee4d2' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2B2B2B', marginBottom: 10 }}>
          踩线 = 跟着同线牌出牌
        </Text>
        <Text style={{ fontSize: 16, color: '#4a4038', lineHeight: 1.8 }}>
          <span style={{ fontWeight: 'bold', color: '#8B1A1A' }}>1-4-7</span> 一条线，<span style={{ fontWeight: 'bold', color: '#C9A227' }}>2-5-8</span> 一条线，<span style={{ fontWeight: 'bold', color: '#1A7F5C' }}>3-6-9</span> 一条线。<br /><br />
          原理：同一条线上的牌，在组顺子时会<span style={{ fontWeight: 'bold', color: '#8B1A1A' }}>互相"竞争"</span>——你需要 123，就不太可能同时还需要 456（因为 234 已经占用了 2 和 3）。所以别人打了 1，同线的 4、7 相对安全。
        </Text>
      </Box>
      <Box style={{ background: '#FFF5F0', borderRadius: 12, padding: 16, border: '1px solid #f5d5c5' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#8B1A1A', marginBottom: 6 }}>
          🛡️ 尾盘安全铁律
        </Text>
        <Text style={{ fontSize: 15, color: '#4a4038', lineHeight: 1.7 }}>
          <span style={{ fontWeight: 'bold' }}>打熟不打生</span>：跟上家 &gt; 对家 &gt; 下家<br />
          <span style={{ fontWeight: 'bold' }}>尾盘打边张</span>：7万比4万安全<br />
          <span style={{ fontWeight: 'bold' }}>听在碰过的牌上</span>：别人碰过的牌再出来的概率低
        </Text>
      </Box>
      <Box style={{ background: 'rgba(201,162,39,0.08)', borderRadius: 8, padding: 14, border: '1px solid #e8d8a8' }}>
        <Text style={{ fontSize: 14, color: '#6b5636', lineHeight: 1.6, fontStyle: 'italic' }}>
          "跟着1、4、7这样的线打牌，避免放炮的意思"<br />
          <span style={{ fontSize: 12, opacity: 0.7 }}>——《理论册》第 4 节 · 70 人划线</span>
        </Text>
      </Box>
    </Box>
  </Box>
  {/* C 页脚 */}
  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'flex-end', alignItems: 'center', marginTop: 12 }}>
    <Text style={{ fontSize: 14, color: '#a0a0a0' }}>11 / 16</Text>
  </Box>
</Slide>
