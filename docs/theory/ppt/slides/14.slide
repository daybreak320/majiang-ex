<Slide style={{
  width: '1280px', height: '720px',
  background: '#FAF7F2', padding: '40px 60px 20px',
  flexDirection: 'column',
}}>
  {/* A 标题区 */}
  <Box style={{ marginBottom: 16 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 4 }}>
      <Box style={{ background: '#C9A227', borderRadius: 6, padding: '4px 10px' }}>
        <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#fff' }}>成都番种</Text>
      </Box>
      <Text style={{ fontSize: 14, color: '#6B6B6B' }}>第四章 · 实战速查</Text>
    </Box>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#2B2B2B' }}>
      番种策略<span style={{ color: '#C9A227' }}>速查表</span>
    </Text>
  </Box>
  {/* B 内容区 - 图表+洞察 */}
  <Box style={{ flexDirection: 'row', gap: 24, flex: 1, height: 500 }}>
    {/* 左：番种 Table */}
    <Box style={{ flex: 7, background: '#FFFEF8', borderRadius: 16, padding: 20, border: '1px solid #eee4d2', flexDirection: 'column', gap: 12 }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#3a2a1a' }}>7 种番种打法要点</Text>
      <Table
        style={{ width: '100%', height: 430 }}
        defaultTextStyle={{ fontSize: 14, textAlign: 'center', color: '#222' }}
        defaultCellStyle={{
          border: {
            left: { width: 1, color: '#eee4d2' },
            right: { width: 1, color: '#eee4d2' },
            top: { width: 1, color: '#eee4d2' },
            bottom: { width: 1, color: '#eee4d2' },
          },
        }}
        cells={[
          [
            { text: '番种', textStyle: { bold: true, color: '#fff' }, cellStyle: { background: { color: '#8B1A1A' } } },
            { text: '打法要点', textStyle: { bold: true, color: '#fff' }, cellStyle: { background: { color: '#8B1A1A' } } },
            { text: '关键提醒', textStyle: { bold: true, color: '#fff' }, cellStyle: { background: { color: '#8B1A1A' } } },
          ],
          [
            { text: '基本胡', textStyle: { bold: true, color: '#8B1A1A' } },
            '以速度为先，尽快下听',
            { text: '别贪大，先上听', textStyle: { color: '#1A7F5C', fontSize: 13 } },
          ],
          [
            { text: '对子胡', textStyle: { bold: true, color: '#8B1A1A' }, cellStyle: { background: { color: '#faf5ec' } } },
            { text: '保留对子，注意碰牌时机', cellStyle: { background: { color: '#faf5ec' } } },
            { text: '碰牌别拆了有效搭子', textStyle: { color: '#1A7F5C', fontSize: 13 }, cellStyle: { background: { color: '#faf5ec' } } },
          ],
          [
            { text: '清一色', textStyle: { bold: true, color: '#8B1A1A' } },
            '花色集中，注意定缺配合',
            { text: '缺门花色优先打', textStyle: { color: '#1A7F5C', fontSize: 13 } },
          ],
          [
            { text: '暗七对', textStyle: { bold: true, color: '#8B1A1A' }, cellStyle: { background: { color: '#faf5ec' } } },
            { text: '不碰不杠，全手保留对子潜力', cellStyle: { background: { color: '#faf5ec' } } },
            { text: '手里有对，忍住不碰', textStyle: { color: '#1A7F5C', fontSize: 13 }, cellStyle: { background: { color: '#faf5ec' } } },
          ],
          [
            { text: '带幺九', textStyle: { bold: true, color: '#8B1A1A' } },
            '保留 1、9 结构',
            { text: '多留边张，少留中张', textStyle: { color: '#1A7F5C', fontSize: 13 } },
          ],
          [
            { text: '清对胡', textStyle: { bold: true, color: '#C9A227' }, cellStyle: { background: { color: '#faf5ec' } } },
            { text: '清一色 + 对子胡复合', cellStyle: { background: { color: '#faf5ec' } } },
            { text: '大牌，先看机会数够不够', textStyle: { color: '#1A7F5C', fontSize: 13 }, cellStyle: { background: { color: '#faf5ec' } } },
          ],
          [
            { text: '将对胡', textStyle: { bold: true, color: '#C9A227' } },
            '只含 2、5、8 的对子胡',
            { text: '天然限牌型，起手合适再考虑', textStyle: { color: '#1A7F5C', fontSize: 13 } },
          ],
        ]}
      />
    </Box>
    {/* 右：洞察卡 */}
    <Box style={{ flex: 3, flexDirection: 'column', gap: 16 }}>
      <Box style={{ background: '#8B1A1A', borderRadius: 12, padding: 16, flex: 1 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FDF6EC', marginBottom: 8 }}>🎯 番种是目标</Text>
        <Text style={{ fontSize: 14, color: '#F3D9B5', lineHeight: 1.7 }}>
          机会数是导航。先定番种方向，<span style={{ color: '#fff', fontWeight: 'bold' }}>再用机会数判断每张牌的取舍</span>——目标越大，越要算清楚代价。
        </Text>
      </Box>
      <Box style={{ background: '#FFFEF8', borderRadius: 12, padding: 16, border: '1px solid #eee4d2', flex: 1 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A7F5C', marginBottom: 8 }}>🔄 定缺配合</Text>
        <Text style={{ fontSize: 14, color: '#4a4038', lineHeight: 1.7 }}>
          定缺看三样：<span style={{ fontWeight: 'bold', color: '#1A7F5C' }}>花色张数、孤张结构、有效搭子</span>，选预期牌效损失最小的缺门。已进代码强制实现。
        </Text>
      </Box>
      <Box style={{ background: '#FFFEF8', borderRadius: 12, padding: 16, border: '1px solid #eee4d2', flex: 1 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#C9A227', marginBottom: 8 }}>🃏 换三张</Text>
        <Text style={{ fontSize: 14, color: '#4a4038', lineHeight: 1.7 }}>
          结合牌型花色分布决定换出哪一色——<span style={{ fontWeight: 'bold', color: '#C9A227' }}>缺门花色优先换出</span>，把负担甩给对手。
        </Text>
      </Box>
    </Box>
  </Box>
  {/* C 页脚 */}
  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'flex-end', alignItems: 'center', marginTop: 12 }}>
    <Text style={{ fontSize: 14, color: '#a0a0a0' }}>14 / 16</Text>
  </Box>
</Slide>
